# ──────────────────────────────────────────────────────────────────────────────
# MailExpert — Environment Configuration
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the values below
# 3. Generate the TLS cert (see README) or use --profile https for Let's Encrypt
# 4. Run:              docker compose up -d --build
# ──────────────────────────────────────────────────────────────────────────────


# ── Access ────────────────────────────────────────────────────────────────────
# Port the app listens on (HTTPS). Default is 443.
APP_PORT=443

# Port the app listens on (HTTP). Default is 80.
# Use this when running behind a reverse proxy that terminates TLS upstream.
# Your proxy should forward X-Forwarded-Proto: https so session cookies work correctly.
APP_HTTP_PORT=80

# Full URL users see in the browser — used in invite emails and CORS.
APP_URL=https://your-domain-or-ip

# Other public origins of this install, comma-separated — for example a direct host next
# to the one behind Cloudflare Access. WebSocket connections and OAuth callbacks accept
# them in addition to APP_URL; register each origin's callback URL with the OAuth client.
# APP_ALT_URLS=


# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED — generate with: openssl rand -hex 16
DB_PASSWORD=

# REQUIRED — generate with: openssl rand -hex 32
# Used to encrypt stored email credentials (passwords, OAuth tokens) at rest.
# WARNING: If this key is lost or changed, all stored credentials become unreadable
#          and users will need to re-enter passwords / re-authenticate OAuth accounts.
ENCRYPTION_KEY=


# ── Database & Redis (advanced — external servers) ────────────────────────────
# By default MailExpert runs its own bundled Postgres and Redis, and these are
# already wired up. Only set these to use EXISTING servers elsewhere on your
# network (e.g. on a non-standard port). If you do, stop/remove the bundled
# `postgres` and `redis` services so they don't run unused.
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=mailexpert
# DB_USER=mailexpert
# REDIS_URL=redis://redis:6379


# ── Storage & permissions (bind mounts / Unraid) ──────────────────────────────
# By default the Postgres and Redis data live in Docker-managed named volumes.
# To store them on a host path instead (e.g. an Unraid appdata share), point these
# at that path, create/chown it to PUID:PGID first, then set PUID/PGID so the
# containers write files as that owner. On Unraid, PUID=99 and PGID=100.
# Leaving PUID/PGID unset keeps the default (root) behaviour with named volumes.
# POSTGRES_DATA=/mnt/user/appdata/mailexpert/postgres
# REDIS_DATA=/mnt/user/appdata/mailexpert/redis
# PUID=99
# PGID=100


# ── Web Push Notifications (optional) ────────────────────────────────────────
# Enables native OS / PWA push notifications for new mail.
# Generate a key pair once with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be either a mailto: address or your APP_URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com


# ── Let's Encrypt (optional — only needed with --profile https) ───────────────
# Only used when running: docker compose --profile https up -d --build
# Requires a real public domain with DNS pointing at this server.
DOMAIN=mail.yourdomain.com
ACME_EMAIL=you@yourdomain.com


# ── Sign-in mode ──────────────────────────────────────────────────────────────
# local (default): username and password, 2FA, OIDC, registration and invites.
# google: only users an admin approved in Admin → Users sign in, through Cloudflare
# Access and/or "Sign in with Google" on a host without Cloudflare. Password login, 2FA,
# OIDC, registration, invites and password reset are off.
# AUTH_MODE=local
#
# Cloudflare Access in front of the install: Zero Trust team domain and the AUD tag of
# the Access application.
# CF_ACCESS_ISSUER=https://<TEAM>.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=<AUD>
#
# "Sign in with Google" for a host that is not behind Cloudflare Access. OAuth client of
# type "Web application", scopes openid and email, authorized redirect URI
# <origin>/oauth/login/google/callback for every public origin. This client is not one
# of the Gmail apps. Never commit a real secret.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
#
# Emails that are always admins and get an account on their first sign-in, comma-separated.
# BOOTSTRAP_ADMIN_EMAILS=


# ── Google OAuth (optional — Gmail accounts) ─────────────────────────────────
# Usually configured in Admin → Integrations. Client credentials are stored as Google
# apps in the database (one per Google Cloud project). GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are read once, at the first startup without any stored app, and
# imported as the first app; later changes to them are ignored. GOOGLE_REDIRECT_URI is
# the shared callback URL of every app. Create an OAuth client of type "Web application"
# in Google Cloud Console and add the redirect URI below as an authorized redirect URI.
# The client secret is sensitive: never commit a real value.
#
# https://mail.google.com/ is a RESTRICTED scope, so the consent screen setup decides
# how long connections last:
#   Internal (project owned by a Google Workspace org)
#     No verification, refresh tokens do not expire, but only that org's accounts
#     can connect.
#   External + Testing
#     Works immediately for listed test users, but Google revokes refresh tokens
#     after 7 days: every mailbox must be reconnected weekly. Development only.
#   External + In production
#     Long-lived tokens for personal @gmail.com accounts, but restricted scopes
#     require Google verification including a security assessment.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain-or-ip/oauth/google/callback


# ── Source-build tuning (advanced) ────────────────────────────────────────────
# Base image for the frontend (nginx) stage when building from source. Some
# hosts with older kernels (e.g. NAS units) cannot execute binaries from the
# newest Alpine package repo — `apk add` in the build dies with "killed by
# signal 9". Point this at an older tag to fix that. Default: nginx:alpine.
# NGINX_BASE=nginx:1.27-alpine


# ── IMAP tuning ───────────────────────────────────────────────────────────────
# Max always-on IMAP connections MailExpert keeps per provider host. Each enabled
# account normally holds one persistent (IDLE) connection, so many accounts on
# ONE mail server can exceed the server's per-user/per-IP connection limit (e.g.
# Dovecot's mail_max_userip_connections, default 10), causing sync errors and a
# snippet-indexer backoff loop. Set this to your provider's limit and MailExpert
# keeps that many accounts on live push and polls the rest on the sync interval.
# Empty or 0 = unlimited (default; unchanged behavior). Only set it if you run
# many accounts on one connection-limited server.
IMAP_MAX_PERSISTENT_PER_HOST=
# How many mailboxes connect at the same time when the server starts. Every
# enabled mailbox connects; this only spreads the logins out. Empty = 3.
IMAP_CONNECT_CONCURRENCY=

# ── Experimental ──────────────────────────────────────────────────────────────
# Demo workspace is disabled by default. Set to true only for local UI demos;
# it bypasses sign-in and uses in-memory mail data.
VITE_DEMO_MODE=false

# Div-based email renderer (replaces iframe). Set to true on a dev instance to
# test before the iframe path is removed. Do not enable in production until the
# full email test matrix has been validated.
VITE_EMAIL_DIV_RENDER=false

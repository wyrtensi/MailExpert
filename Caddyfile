{
    # Email for Let's Encrypt expiry notifications (optional but recommended)
    email {$ACME_EMAIL}
    # Runtime error logs can include the callback URL when the upstream is unavailable.
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete code
                    delete state
                }
            }
        }
    }
}

{$DOMAIN} {
    reverse_proxy frontend:443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}
